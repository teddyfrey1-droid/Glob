# --- Supabase (active la persistance de la waitlist) ---
# Sans ces variables, la landing tourne en "mode démo" : la waitlist accepte
# les inscriptions mais ne les persiste pas (elles sont juste loguées).
#
# Le projet Supabase "latitude" (eu-west-3 / Paris) est déjà créé, et la table
# `waitlist` + sa policy RLS sont en place (voir supabase/schema.sql).
#
# Où renseigner :
#   - en local  : crée un fichier .env.local (non commité) avec ces clés
#   - sur Vercel : Project Settings > Environment Variables, puis redeploy

SUPABASE_URL=https://siuioxejppdwnsdnyuhq.supabase.co

# Clé publishable (format sb_publishable_…). SÛRE à exposer : une policy RLS
# n'autorise que l'INSERT dans `waitlist`, jamais la lecture.
SUPABASE_PUBLISHABLE_KEY=
